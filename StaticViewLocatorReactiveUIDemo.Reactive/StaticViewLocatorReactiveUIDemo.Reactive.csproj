<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>StaticViewLocatorReactiveUIDemo.Reactive</AssemblyName>
    <RootNamespace>StaticViewLocatorReactiveUIDemo</RootNamespace>
    <DefineConstants>$(DefineConstants);REACTIVEUI_SYSTEM_REACTIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="ReactiveUI.Avalonia.Reactive" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\StaticViewLocatorReactiveUIDemo\**\*.cs"
             Exclude="..\StaticViewLocatorReactiveUIDemo\bin\**;..\StaticViewLocatorReactiveUIDemo\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="..\StaticViewLocatorReactiveUIDemo\**\*.axaml"
                  Exclude="..\StaticViewLocatorReactiveUIDemo\bin\**;..\StaticViewLocatorReactiveUIDemo\obj\**"
                  Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StaticViewLocator\StaticViewLocator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
